os64 % commands:
help  - list commands
mem   - show free physical pages
ticks - show timer tick count
heap  - show kernel heap stats
disk  - show raw boot block device info
pwd   - show current directory
cd    - change current directory
ls    - list directory entries
cat   - print file contents
stat  - show inode metadata
touch - create an empty file
mkdir - create a directory
write - replace a file with text
append - append text to a file
rm    - remove a file or empty dir
sync  - flush filesystem metadata
run <path> [args] - run a user ELF and wait for exit
ps    - show processes and threads
reboot / shutdown - sync disk and restart / stop
irq   - show timer/keyboard irq stats
bootinfo - show boot handoff info
e820  - show boot memory map
smp   - show online CPUs and per-CPU user work
cpu   - show cpuid summary
uptime - show tick-based uptime
echo  - print text back
history - show recent commands
clear - clear console area
commands: /bin PATH lookup; quotes; | < > >> 2> ; && || &
jobs / wait - list / join background pipelines
dmesg / logsave PATH - inspect / save the bounded kernel log
perf - CPU, memory and scheduler counters
net / ping IPv4 - network counters / ICMP echo
